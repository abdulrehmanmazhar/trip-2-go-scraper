{
    "name": "trip-2-go-scraper",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "format:check": "prettier --ignore-path .prettierignore --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md,html,yml,yaml}\"",
        "format:fix": "prettier --ignore-path .prettierignore --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md,html,yml,yaml}\"",
        "build:dashboard": "npm run start --workspace=scripts/dashboard-build"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,json,css,scss,md}": [
            "prettier --ignore-path .prettierignore --write"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "@eslint/js": "^9.39.2",
        "@types/eslint__js": "^9.14.0",
        "@types/express": "^5.0.6",
        "@types/node": "^25.0.10",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "npm-run-all": "^4.1.5",
        "prettier": "3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.53.1"
    },
    "workspaces": [
        "configs/ts-config",
        "configs/eslint-config",
        "packages/shared-utils",
        "packages/trip-theme",
        "apps/network-recorder",
        "apps/dump-analyzer-backend",
        "apps/dump-analyzer-client",
        "apps/workflow-recorder",
        "apps/google-account-creator",
        "apps/dashboard-client",
        "apps/dashboard-backend",
        "apps/bot",
        "apps/workflow-recorder/frontend",
        "apps/workflow-recorder/backend",
        "apps/workflow-recorder/cli",
        "scripts/dashboard-build",
        "scripts/workflows",
        "packages/ws-core"
    ]
