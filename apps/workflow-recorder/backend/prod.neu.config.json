{
    "applicationId": "app.neutralino.vite",
    "binaryName": "Figgo Recorder",
    "defaultMode": "window",
    "documentRoot": "/dist/",
    "url": "/index.html",
    "enableServer": true,
    "port": 0,
    "singlePageServe": true,
    "enableNativeAPI": true,
    "nativeAllowList": ["app.*", "os.*", "filesystem.*", "storage.*", "window.*", "events.*", "debug.*", "extensions.*", "updater.*", "clipboard.*"],
    "modes": {
        "window": {
            "title": "Workflow Recorder",
            "width": 1200,
            "height": 800,
            "icon": "/trip2go.png",
            "injectGlobals": true
        }
    },
    "cli": {
        "resourcesPath": "/dist/"
    }
}
