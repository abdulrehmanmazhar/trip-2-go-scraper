<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0" />
        <title>Activate your Figgo Atlas account</title>
        <style>
            /* RESET & GLOBAL STYLES */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 0;
                background-color: #f4f7fc; /* softer background */
                font-family:
                    'Inter',
                    -apple-system,
                    BlinkMacSystemFont,
                    'Segoe UI',
                    Roboto,
                    Helvetica,
                    Arial,
                    sans-serif;
                color: #10182f;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            /* main email wrapper with safe padding */
            .wrapper {
                width: 100%;
                table-layout: fixed;
                padding: 40px 16px;
                background-color: #f4f7fc;
            }

            /* centered card container */
            .container {
                max-width: 520px; /* slightly narrower for elegance */
                margin: 0 auto;
                background: #ffffff;
                border-radius: 24px;
                box-shadow:
                    0 20px 35px -8px rgba(0, 0, 0, 0.07),
                    0 8px 16px -6px rgba(0, 0, 0, 0.03);
                overflow: hidden;
                border: 1px solid rgba(226, 232, 240, 0.4);
            }

            /* HEADER with subtle gradient line */
            .header {
                padding: 40px 40px 16px 40px;
                text-align: center;
                background: linear-gradient(to bottom, #ffffff, #fafcff);
            }

            .logo {
                font-size: 22px;
                font-weight: 600;
                letter-spacing: 0.8px;
                color: #0f2b4b;
                display: inline-block;
                border-bottom: 2px solid #e6edf6;
                padding-bottom: 8px;
                text-transform: uppercase;
                line-height: 1.2;
            }

            /* main content area with refined spacing */
            .content {
                padding: 8px 40px 24px 40px;
                text-align: left;
            }

            h1 {
                font-size: 24px;
                font-weight: 600;
                margin-bottom: 20px;
                color: #0b1f33;
                letter-spacing: -0.2px;
                line-height: 1.3;
            }

            p {
                font-size: 15px;
                line-height: 1.7;
                color: #2d3a4f;
                margin: 16px 0;
            }

            p strong {
                color: #0b1f33;
                font-weight: 600;
            }

            /* polished code box with subtle inner glow */
            .code-box {
                margin: 28px 0 24px;
                padding: 18px 20px;
                background: #f0f5fe;
                border: 1px solid #d9e4f2;
                border-radius: 16px;
                font-size: 28px;
                font-weight: 600;
                text-align: center;
                letter-spacing: 6px;
                color: #1f3a6b;
                box-shadow:
                    inset 0 2px 4px rgba(0, 27, 65, 0.02),
                    0 1px 2px rgba(0, 0, 0, 0.02);
                font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
                word-break: break-word;
            }

            /* button container with extra margin */
            .button-container {
                text-align: center;
                margin: 32px 0 24px;
            }

            /* primary CTA — refined, with hover effect */
            .button {
                display: inline-block;
                background-color: #0f2f54; /* deeper navy */
                color: #ffffff;
                text-decoration: none;
                padding: 16px 34px;
                border-radius: 50px; /* fully rounded, modern */
                font-size: 15px;
                font-weight: 600;
                letter-spacing: 0.3px;
                border: 1px solid transparent;
                transition:
                    background-color 0.2s ease,
                    box-shadow 0.2s ease;
                box-shadow: 0 8px 18px -6px rgba(15, 47, 84, 0.2);
            }

            .button:hover {
                background-color: #153e6b;
                box-shadow: 0 12px 22px -8px rgba(15, 47, 84, 0.3);
            }

            /* subtle link style inside footer */
            .footer {
                padding: 24px 40px 32px;
                font-size: 13px;
                text-align: center;
                color: #75869c;
                border-top: 1px solid #ecf1f7;
                background: #fbfdff;
            }

            .footer p {
                margin: 6px 0;
                font-size: 13px;
                color: #5e7188;
            }

            .footer a {
                color: #0f2f54;
                text-decoration: none;
                font-weight: 500;
                border-bottom: 1px dotted #b3c6df;
            }

            .footer a:hover {
                color: #102c4a;
                border-bottom: 1px solid #0f2f54;
            }

            /* extra polish for small screens */
            @media only screen and (max-width: 520px) {
                .wrapper {
                    padding: 20px 12px;
                }
                .container {
                    border-radius: 20px;
                }
                .header,
                .content,
                .footer {
                    padding-left: 24px;
                    padding-right: 24px;
                }
                .header {
                    padding-top: 32px;
                }
                .code-box {
                    font-size: 24px;
                    letter-spacing: 4px;
                    padding: 14px 16px;
                }
                .button {
                    padding: 14px 28px;
                    font-size: 14px;
                }
                h1 {
                    font-size: 22px;
                }
            }

            @media only screen and (max-width: 380px) {
                .code-box {
                    font-size: 20px;
                    letter-spacing: 2px;
                }
            }

            /* handle dark mode gently (preserve lightness) */
            @media (prefers-color-scheme: dark) {
                body {
                    background-color: #e9eef3; /* keep light background for email compatibility */
                }
                /* most email clients ignore prefers-color-scheme, but we keep it minimal */
            }
        </style>
    </head>

    <body>
        <div class="wrapper">
            <div class="container">
                <!-- header with brand name refined -->
                <div class="header">
                    <div class="logo">FIGGO ATLAS</div>
                </div>

                <!-- main content with dynamic placeholders -->
                <div class="content">
                    <h1>✨ Activate your account</h1>

                    <p>Hi <strong><%= user.name %></strong>,</p>

                    <p>
                        Welcome to Figgo Atlas. To complete your registration and activate your account, please use the code below or click the
                        button. This link will expire in 24 hours.
                    </p>

                    <!-- elegant code display -->
                    <div class="code-box"><%= activationCode || "N/A" %></div>

                    <!-- primary call to action -->
                    <div class="button-container">
                        <a
                            href="<%= activationLink %>"
                            class="button"
                            target="_blank"
                            rel="noopener">
                            Activate account
                        </a>
                    </div>

                    <p style="font-size: 14px; color: #5e7188; margin-top: 16px">
                        If the button doesn’t work, copy and paste this link into your browser:<br />
                        <span style="color: #1f3a6b; word-break: break-word"><%= activationLink %></span>
                    </p>

                    <p style="margin-top: 24px">If you didn’t create an account, please disregard this email — no further action is needed.</p>
                </div>

                <!-- footer with support and copyright -->
                <div class="footer">
                    <p>
                        Need assistance? Contact
                        <a href="mailto:abdurrahmanweb@outlook.com">support@figgoatlas.com</a>
                    </p>
                    <p>© <%= new Date().getFullYear() %> Figgo Atlas, Inc. All rights reserved.</p>
                    <p style="margin-top: 12px; font-size: 12px; color: #8e9db3">1234 Market Street, San Francisco, CA 94105</p>
                </div>
            </div>
        </div>
    </body>
</html>
